# Reference only: this file has no valid secrets and must not be used unchanged.
# Generate .env.production with:
# npm run env:production -- --origin https://quest.example.com --admin admin@example.com
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/almaty.sqlite
# Production Compose overrides DATABASE_PATH to /app/data/almaty.sqlite.
PUBLIC_ORIGIN=https://quest.example.com
COOKIE_SECURE=true
REQUIRE_ADMIN_MFA=true
SESSION_IDLE_MINUTES=30
TRUST_PROXY=loopback
JSON_LOGS=true
ADMIN_EMAIL=admin@example.com
# Only used for first bootstrap. Generated randomly by init-env.mjs; remove after bootstrap.
ADMIN_PASSWORD=
# Three independent 32-byte random keys, each encoded as exactly 64 hexadecimal characters.
DATA_ENCRYPTION_KEY=
AUDIT_HMAC_KEY=
BACKUP_ENCRYPTION_KEY=
MAP_STYLE=https://tiles.openfreemap.org/styles/dark

# v0.4 pilot monetization. Manual web invoicing is OFF until an operator configures the process.
# Fixed 30-day entitlements; these are pilot price hypotheses in KZT, not auto-renewing subscriptions.
BILLING_MANUAL_ENABLED=false
BILLING_PLUS_KZT=1490
BILLING_BUSINESS_START_KZT=14990
BILLING_BUSINESS_PRO_KZT=49990
# Server-only AI credentials. Keep both empty for clearly labelled scripted companion replies.
# Set an explicit model available in your provider project; no model/pricing is assumed by the app.
OPENAI_API_KEY=
OPENAI_PET_MODEL=
# Shared across users/replicas: generation turns/day (UTC), not individual HTTP requests or a currency budget.
PET_AI_GLOBAL_DAILY_LIMIT=1000
# Total timeout for input moderation + response generation + output moderation; no automatic retries.
PET_AI_TIMEOUT_MS=20000

# v0.5 photographs: shared SQL pilot storage, normalized JPEG bytes only.
# Base64 (~33% overhead), database/WAL and backups need additional capacity.
PHOTO_STORAGE_LIMIT_MB=100
# Successful uploads per user per UTC day (1..20); withdrawal does not reset this count.
PHOTO_DAILY_UPLOAD_LIMIT=5
# Non-withdrawn photographs per user, including pending/rejected (1..100).
PHOTO_RETAINED_LIMIT=20

# v0.6 product operator metadata. Set real public contacts/HTTPS documents before release.
SUPPORT_EMAIL=
PRIVACY_URL=
TERMS_URL=
# Required by release:check only while manual invoices are enabled.
BILLING_CONTACT_EMAIL=
# Extra tile/sprite/glyph HTTPS origins for custom styles (comma-separated, max 6).
# The style origin and OpenFreeMap are allowed automatically; all replicas/mobile builds must match.
MAP_RESOURCE_ORIGINS=

# v0.6 bounded HTTP admission and credential hashing per application process.
HTTP_MAX_INFLIGHT=128
HTTP_UPLOAD_CONCURRENCY=2
HTTP_BODY_TIMEOUT_MS=15000
HTTP_RESPONSE_TIMEOUT_MS=45000
HTTP_JSON_LIMIT_KB=64
PASSWORD_KDF_CONCURRENCY=2
# Bound rate-limit key cardinality in the shared database.
RATE_LIMIT_MAX_KEYS=10000

# v0.6 gameplay policy: use identical values on every replica.
# These settings affect future validations/awards; historical rewards are not rewritten.
GAME_GPS_MAX_AGE_SECONDS=90
GAME_GPS_MAX_ACCURACY_METERS=80
TERRITORY_DAILY_VISIT_LIMIT=10
ADVENTURE_PET_XP=20
PHOTO_DISCOVERY_XP=20
PHOTO_PET_XP=10
PHOTO_VOTER_MIN_AGE_HOURS=24
